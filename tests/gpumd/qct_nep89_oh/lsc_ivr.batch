#!/bin/bash
#SBATCH --job-name=lsc-ivr
#SBATCH --partition=16V100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --qos=flood-1o2gpu
#SBATCH --time=01:00:00

source /etc/profile.d/lmod.sh
module load cuda/12.4.1
export OMP_NUM_THREADS=1
source /opt/sai_config/mps_mapping.d/${SLURM_JOB_PARTITION}.bash

REVIEW_ROOT="$HOME/workdir_sinano-fanzhaochuan/yishangzhao/gpumd-qct-review"
GPUMD_BIN="${REVIEW_ROOT}/src/gpumd"
TEST_BASE="${REVIEW_ROOT}/tests/gpumd/qct_nep89_oh"

PASS=0
FAIL=0
FAILED_TESTS=""

echo "============================================"
echo "LSC-IVR Test Suite - $(date)"
echo "Binary: ${GPUMD_BIN}"
echo "Node:   $(hostname)"
echo "============================================"

run_lsc_test() {
    local test_name="$1"
    local test_dir="$2"

    echo ""
    echo "============================================"
    echo "TEST: ${test_name}"
    echo "DIR:  ${test_dir}"
    echo "============================================"

    cd "${test_dir}" 2>/dev/null || { echo "FAIL: cannot cd"; FAIL=$((FAIL+1)); FAILED_TESTS="${FAILED_TESTS} ${test_name}"; return; }

    # Clean generated outputs
    rm -f gpumd.log thermo.out qct_initial.out qct_initial.xyz qct_trajectory.xyz qct_thermo.csv \
          qct_hessian.out qct_eigenvector.out qct_stationary.xyz neighbor.out nvidia-smi.log \
          qct_initial_summary.csv qct_lsc_correlation.csv qct_lsc_spectrum.csv lsc_ivr_config.json

    echo "--- GPU info ---"
    nvidia-smi -L 2>&1 | head -2
    echo ""
    echo "--- run.in ---"
    cat run.in
    echo ""
    echo "--- model.xyz ---"
    cat model.xyz

    echo ""
    echo "=== Running GPUMD ==="
    "${GPUMD_BIN}" > gpumd.log 2>&1
    local rc=$?

    if [ ${rc} -ne 0 ]; then
        echo "FAIL: gpumd exited with code ${rc}"
        echo "--- last 50 lines of gpumd.log ---"
        tail -50 gpumd.log 2>/dev/null
        FAIL=$((FAIL+1))
        FAILED_TESTS="${FAILED_TESTS} ${test_name}"
        return
    fi
    echo "GPUMD exit code: ${rc}"

    echo ""
    echo "--- gpumd.log (key lines) ---"
    grep -E "sampling mode|Wigner|reweight|temperature|seed|replica|frequency|Run |Hessian|stationary" gpumd.log 2>/dev/null | head -30

    echo ""
    echo "--- Output files ---"
    ls -la

    echo ""
    echo "--- qct_initial_summary.csv ---"
    cat qct_initial_summary.csv 2>/dev/null || { echo "NOT FOUND"; FAIL=$((FAIL+1)); FAILED_TESTS="${FAILED_TESTS} ${test_name}"; return; }

    echo ""
    echo "--- qct_initial.out (first 30 lines) ---"
    head -30 qct_initial.out 2>/dev/null || echo "NOT FOUND"

    # Verify frequency is correct (~115 THz for OH, not ~722)
    echo ""
    echo "--- Frequency check ---"
    FREQ=$(grep "^0," qct_initial.out 2>/dev/null | grep ",yes," | head -1 | cut -d, -f4)
    echo "Active mode frequency: ${FREQ} THz"
    python3 -c "
freq = float('${FREQ}')
if freq > 200:
    print(f'WARNING: frequency {freq:.1f} THz is too high for OH! Expected ~115 THz')
    print('This suggests the 2*pi frequency conversion bug is not fixed.')
elif 50 < freq < 200:
    print(f'OK: frequency {freq:.1f} THz is in the expected range for OH stretch (~115 THz)')
    print(f'    wavenumber = {freq*33.356:.0f} cm-1')
else:
    print(f'WARNING: frequency {freq:.1f} THz is unexpected')
" 2>&1

    echo ""
    echo "============================================"
    echo "Running lsc_ivr.py post-processing"
    echo "============================================"

    # Create config for position autocorrelation of O atom (atom 0, x-axis)
    cat > lsc_ivr_config.json << 'JSON'
{
  "operator_A": {"name": "position", "params": {"atom": 0, "axis": 0}},
  "operator_B": {"name": "position", "params": {"atom": 0, "axis": 0}}
}
JSON

    python3 "${REVIEW_ROOT}/tools/qct/lsc_ivr.py" \
      --trajectory qct_trajectory.xyz \
      --summary qct_initial_summary.csv \
      --output qct_lsc_correlation.csv \
      --fft qct_lsc_spectrum.csv \
      --time-step 0.1 \
      --dump-interval 1 \
      --config lsc_ivr_config.json 2>&1

    if [ $? -ne 0 ]; then
        echo "FAIL: lsc_ivr.py failed"
        FAIL=$((FAIL+1))
        FAILED_TESTS="${FAILED_TESTS} ${test_name}"
        return
    fi

    echo ""
    echo "--- Correlation output (first 20 lines) ---"
    head -20 qct_lsc_correlation.csv 2>/dev/null

    echo ""
    echo "--- Correlation output (sampled every 500 steps) ---"
    awk 'NR==1 || NR%500==0' qct_lsc_correlation.csv 2>/dev/null

    echo ""
    echo "--- Spectrum output (first 20 lines) ---"
    head -20 qct_lsc_spectrum.csv 2>/dev/null

    # Find peak in spectrum (skip DC and low-freq noise)
    echo ""
    echo "--- Spectrum peak analysis ---"
    python3 -c "
import csv
with open('qct_lsc_spectrum.csv') as f:
    reader = csv.reader(f)
    next(reader)  # skip header
    rows = [(float(r[0]), float(r[1]), float(r[2])) for r in reader]
print(f'Total spectrum points: {len(rows)}')
print(f'Max frequency: {rows[-1][0]:.1f} THz')
# Find peak excluding first 5 low-freq points (DC + noise)
peak = max(rows[5:], key=lambda x: x[2])
print(f'Peak: freq={peak[0]:.4f} THz, wavenumber={peak[1]:.2f} cm-1, intensity={peak[2]:.6e}')
print(f'Expected OH stretch: ~115 THz = ~3834 cm-1')
# Check if peak is near expected frequency
if abs(peak[0] - 115) < 20:
    print('PASS: Peak frequency matches OH stretch!')
else:
    print(f'WARNING: Peak at {peak[0]:.1f} THz is not near expected 115 THz')
    # Show top 5 peaks
    sorted_rows = sorted(rows[5:], key=lambda x: x[2], reverse=True)[:5]
    print('Top 5 peaks:')
    for r in sorted_rows:
        print(f'  freq={r[0]:.4f} THz, wavenumber={r[1]:.2f} cm-1, intensity={r[2]:.6e}')
" 2>&1

    echo ""
    echo "PASS: ${test_name}"
    PASS=$((PASS+1))
}

# ============================================================
# Test 1: Wigner with anharmonic reweighting
# ============================================================
run_lsc_test "OH-wigner-reweight" "${TEST_BASE}/wigner"

# ============================================================
# Test 2: Wigner without anharmonic reweighting (pure harmonic)
# ============================================================
run_lsc_test "OH-wigner-no-reweight" "${TEST_BASE}/wigner_no_reweight"

# ============================================================
# Summary
# ============================================================
echo ""
echo "============================================"
echo "SUMMARY"
echo "============================================"
echo "PASS: ${PASS}"
echo "FAIL: ${FAIL}"
if [ ${FAIL} -gt 0 ]; then
    echo "FAILED TESTS:${FAILED_TESTS}"
fi
echo "============================================"
echo "Done - $(date)"
