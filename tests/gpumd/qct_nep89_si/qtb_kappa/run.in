# QTB thermal conductivity: Si diamond 3x3x3 (216 atoms), NEP89, 300K
# Phase 1: NVT-QTB equilibration with quantum colored noise
potential    ../../../../potentials/nep/nep89_20250409/nep89_20250409.txt
time_step    0.5
velocity     300
ensemble     nvt_qtb 300 300 100
dump_thermo  100
run          50000
# Phase 2: NVE production with HAC (classical propagation, QTB initial conditions)
ensemble     nve
compute_hac  20 500 10
dump_thermo  100
run          200000
