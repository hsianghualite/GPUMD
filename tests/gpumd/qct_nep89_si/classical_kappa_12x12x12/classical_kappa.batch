#!/bin/bash
#SBATCH --job-name=class-kappa-12
#SBATCH --partition=16V100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --qos=rush-1o2gpu
#SBATCH --time=08:00:00

source /etc/profile.d/lmod.sh
module load cuda/12.4.1
export OMP_NUM_THREADS=1
source /opt/sai_config/mps_mapping.d/${SLURM_JOB_PARTITION}.bash

REVIEW_ROOT="$HOME/workdir_sinano-fanzhaochuan/yishangzhao/gpumd-qct-review"
GPUMD_BIN="${REVIEW_ROOT}/src/gpumd"
TEST_DIR="${REVIEW_ROOT}/tests/gpumd/qct_nep89_si/classical_kappa_12x12x12"

echo "============================================"
echo "Classical Thermal Conductivity (paper repro)"
echo "System: Si diamond 12x12x12 (13824 atoms), NEP89, 300K"
echo "NPT: 500 ps, NVE: 10 ns, HAC: 1 ns correlation"
echo "Binary: ${GPUMD_BIN}"
echo "Date:   $(date)"
echo "Node:   $(hostname)"
echo "============================================"

cd "${TEST_DIR}" || { echo "FAIL: cannot cd to ${TEST_DIR}"; exit 1; }

rm -f gpumd.log thermo.out hac.out stress.out neighbor.out

echo "--- GPU info ---"
nvidia-smi -L 2>&1 | head -2
echo ""
echo "--- run.in ---"
cat run.in
echo ""
echo "--- model.xyz (header) ---"
head -2 model.xyz

echo ""
echo "=== Running GPUMD ==="
"${GPUMD_BIN}" > gpumd.log 2>&1
rc=$?

if [ ${rc} -ne 0 ]; then
    echo "FAIL: gpumd exited with code ${rc}"
    echo "--- last 100 lines of gpumd.log ---"
    tail -100 gpumd.log 2>/dev/null
    exit 1
fi
echo "GPUMD exit code: ${rc}"

echo ""
echo "--- gpumd.log (key lines) ---"
grep -E "Use |NPT|NVE|Run |HAC|heat|periodic|PBC|atoms|step|temperature|Time used|Speed" gpumd.log 2>/dev/null | head -30

echo ""
echo "--- Output files ---"
ls -la

# Check thermo output
if [ -f "thermo.out" ]; then
    echo ""
    echo "--- thermo.out analysis ---"
    python3 -c "
import numpy as np
data = np.loadtxt('thermo.out')
print(f'Thermo data: {data.shape[0]} rows')
n_npt = 500000 // 1000  # 500 rows for NPT phase
print(f'Phase 1 (NPT, first {n_npt} rows):')
print(f'  T range: {data[:n_npt,0].min():.1f} - {data[:n_npt,0].max():.1f} K')
print(f'  T mean:  {data[:n_npt,0].mean():.1f} K')
if data.shape[0] > n_npt:
    nve = data[n_npt:]
    print(f'Phase 2 (NVE, rows {n_npt}+):')
    print(f'  T range: {nve[:,0].min():.1f} - {nve[:,0].max():.1f} K')
    print(f'  T mean:  {nve[:,0].mean():.1f} K')
    if data.shape[1] >= 4:
        e_drift = nve[-1,3] - nve[0,3]
        e_mean = np.mean(nve[:,3])
        print(f'  Energy drift: {e_drift:.6f} eV ({e_drift/e_mean*100:.6f}%)')
" 2>&1
fi

# Check HAC output
if [ -f "hac.out" ]; then
    echo ""
    echo "--- hac.out info ---"
    wc -l hac.out
    echo "--- hac.out (first 3 lines) ---"
    head -3 hac.out
    echo "..."
    echo "--- hac.out (last 3 lines) ---"
    tail -3 hac.out

    echo ""
    echo "=== Thermal Conductivity Analysis ==="
    python3 -c "
import numpy as np
data = np.loadtxt('hac.out')
ncols = data.shape[0]
t = data[:, 0]
print(f'HAC data: {ncols} rows, {data.shape[1]} columns')
print(f'Time range: {t[0]:.4f} - {t[-1]:.4f} ps')
print(f'Correlation window: {t[-1]:.1f} ps')

kx = data[:, 6] + data[:, 7]
ky = data[:, 8] + data[:, 9]
kz = data[:, 10]
kappa_avg = (kx + ky + kz) / 3.0

print(f'')
print(f'Final kappa values:')
print(f'  kappa_x = {kx[-1]:.4f} W/m/K')
print(f'  kappa_y = {ky[-1]:.4f} W/m/K')
print(f'  kappa_z = {kz[-1]:.4f} W/m/K')
print(f'  kappa_avg = {kappa_avg[-1]:.4f} W/m/K')

print(f'')
print(f'Convergence check (kappa_avg at different correlation times):')
for target_ps in [100, 200, 500, 800, 1000]:
    idx = np.argmin(np.abs(t - target_ps))
    if idx > 0:
        print(f'  {t[idx]:.0f} ps: {kappa_avg[idx]:.4f} W/m/K')

last_10pct = kappa_avg[int(ncols*0.9):]
print(f'')
print(f'  Last 10% mean: {np.mean(last_10pct):.4f} W/m/K')
print(f'  Last 10% std:  {np.std(last_10pct):.4f} W/m/K')
print(f'  Last 10% RSD:  {np.std(last_10pct)/np.mean(last_10pct)*100:.1f}%')

print(f'')
print(f'Per-component (last 10% mean):')
for name, arr in [('kx', kx), ('ky', ky), ('kz', kz)]:
    lq = arr[int(ncols*0.9):]
    print(f'  {name}: {np.mean(lq):.4f} +/- {np.std(lq):.4f} W/m/K')

print(f'')
print(f'Paper reference: kappa ~ 102 +/- 6 W/m/K')
" 2>&1
else
    echo "WARNING: hac.out not found"
    tail -30 gpumd.log
    exit 1
fi

echo ""
echo "============================================"
echo "Classical kappa test completed - $(date)"
echo "============================================"
