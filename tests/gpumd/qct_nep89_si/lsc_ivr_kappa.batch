#!/bin/bash
#SBATCH --job-name=lsc-kappa
#SBATCH --partition=16V100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --qos=flood-1o2gpu
#SBATCH --time=02:00:00

source /etc/profile.d/lmod.sh
module load cuda/12.4.1
export OMP_NUM_THREADS=1
source /opt/sai_config/mps_mapping.d/${SLURM_JOB_PARTITION}.bash

REVIEW_ROOT="$HOME/workdir_sinano-fanzhaochuan/yishangzhao/gpumd-qct-review"
GPUMD_BIN="${REVIEW_ROOT}/src/gpumd"
TEST_BASE="${REVIEW_ROOT}/tests/gpumd/qct_nep89_si"

PASS=0
FAIL=0
FAILED_TESTS=""

echo "============================================"
echo "LSC-IVR Thermal Conductivity Test - $(date)"
echo "System: Si diamond 3x3x3 (216 atoms), NEP89"
echo "Binary: ${GPUMD_BIN}"
echo "Node:   $(hostname)"
echo "============================================"

run_test() {
    local test_name="$1"
    local test_dir="$2"

    echo ""
    echo "============================================"
    echo "TEST: ${test_name}"
    echo "DIR:  ${test_dir}"
    echo "============================================"

    cd "${test_dir}" 2>/dev/null || { echo "FAIL: cannot cd"; FAIL=$((FAIL+1)); FAILED_TESTS="${FAILED_TESTS} ${test_name}"; return; }

    rm -f gpumd.log thermo.out hac.out stress.out qct_initial.out qct_initial.xyz \
          qct_hessian.out qct_eigenvector.out qct_stationary.xyz neighbor.out \
          qct_initial_summary.csv qct_thermo.csv qct_trajectory.xyz

    echo "--- GPU info ---"
    nvidia-smi -L 2>&1 | head -2
    echo ""
    echo "--- run.in ---"
    cat run.in
    echo ""
    echo "--- model.xyz (header) ---"
    head -2 model.xyz

    echo ""
    echo "=== Running GPUMD ==="
    "${GPUMD_BIN}" > gpumd.log 2>&1
    local rc=$?

    if [ ${rc} -ne 0 ]; then
        echo "FAIL: gpumd exited with code ${rc}"
        echo "--- last 80 lines of gpumd.log ---"
        tail -80 gpumd.log 2>/dev/null
        FAIL=$((FAIL+1))
        FAILED_TESTS="${FAILED_TESTS} ${test_name}"
        return
    fi
    echo "GPUMD exit code: ${rc}"

    echo ""
    echo "--- gpumd.log (key lines) ---"
    grep -E "Use |LSC-IVR|Wigner|sampling mode|reweight|temperature|seed|replica|frequency|Run |Hessian|stationary|mode|atoms|HAC|heat|periodic|PBC" gpumd.log 2>/dev/null | head -40

    echo ""
    echo "--- Output files ---"
    ls -la

    # Check Wigner output
    if [ -f "qct_initial_summary.csv" ]; then
        echo ""
        echo "--- qct_initial_summary.csv ---"
        cat qct_initial_summary.csv
    fi

    # Check HAC output
    if [ -f "hac.out" ]; then
        echo ""
        echo "--- hac.out (first 5 lines) ---"
        head -5 hac.out
        echo "..."
        echo "--- hac.out (last 5 lines) ---"
        tail -5 hac.out

        # Analyze thermal conductivity
        echo ""
        echo "--- Thermal conductivity analysis ---"
        python3 -c "
import numpy as np
data = np.loadtxt('hac.out')
ncols = data.shape[1]
t = data[:, 0]
print(f'HAC data: {data.shape[0]} rows, {ncols} columns')
print(f'Time range: {t[0]:.1f} - {t[-1]:.1f} fs')
# hac.out format: time(ps), hac_xi, hac_xo, hac_yi, hac_yo, hac_z,
#                 rtc_xi, rtc_xo, rtc_yi, rtc_yo, rtc_z (11 columns)
# kx = rtc_xi + rtc_xo, ky = rtc_yi + rtc_yo, kz = rtc_z
if ncols == 11:
    kx = data[:, 6] + data[:, 7]
    ky = data[:, 8] + data[:, 9]
    kz = data[:, 10]
    print(f'kappa_x at end: {kx[-1]:.4f} W/m/K')
    print(f'kappa_y at end: {ky[-1]:.4f} W/m/K')
    print(f'kappa_z at end: {kz[-1]:.4f} W/m/K')
    print(f'kappa_avg at end: {(kx[-1]+ky[-1]+kz[-1])/3:.4f} W/m/K')
else:
    print('Unexpected column count:', ncols)
    print('Last row:', data[-1, :])
" 2>&1
    else
        echo "WARNING: hac.out not found"
        echo "Checking gpumd.log for errors..."
        tail -20 gpumd.log
    fi

    # Check mode frequencies
    if [ -f "qct_initial.out" ]; then
        echo ""
        echo "--- Mode frequency analysis ---"
        python3 -c "
import csv
try:
    with open('qct_initial.out') as f:
        reader = csv.reader(f)
        rows = [r for r in reader if not r[0].startswith('#')]
    print(f'Total modes: {len(rows)}')
    active = [r for r in rows if len(r) > 4 and r[-1].strip() == 'yes']
    print(f'Active modes: {len(active)}')
    if active:
        freqs = [float(r[3]) for r in active]
        print(f'Frequency range: {min(freqs):.2f} - {max(freqs):.2f} THz')
        print(f'  (wavenumber: {min(freqs)*33.356:.0f} - {max(freqs)*33.356:.0f} cm-1)')
        sorted_freqs = sorted(freqs, reverse=True)[:5]
        print('Top 5 highest frequencies:')
        for f in sorted_freqs:
            print(f'  {f:.2f} THz = {f*33.356:.0f} cm-1')
except Exception as e:
    print(f'Error: {e}')
" 2>&1
    fi

    echo ""
    echo "PASS: ${test_name}"
    PASS=$((PASS+1))
}

# ============================================================
# Test 1: LSC-IVR ensemble (new dedicated keyword) with PBC
# ============================================================
run_test "Si-lsc-ivr-ensemble-kappa" "${TEST_BASE}/lsc_ivr_ensemble"

# ============================================================
# Test 2: LSC-IVR Wigner with anharmonic reweighting (legacy qct wigner)
# ============================================================
run_test "Si-wigner-reweight-kappa" "${TEST_BASE}/wigner"

# ============================================================
# Test 3: LSC-IVR Wigner without anharmonic reweighting (legacy qct wigner)
# ============================================================
run_test "Si-wigner-no-reweight-kappa" "${TEST_BASE}/wigner_no_reweight"

# ============================================================
# Test 4: Classical MD (NVT equilibration + NVE HAC)
# ============================================================
run_test "Si-classical-kappa" "${TEST_BASE}/classical_kappa"

# ============================================================
# Summary
# ============================================================
echo ""
echo "============================================"
echo "SUMMARY"
echo "============================================"
echo "PASS: ${PASS}"
echo "FAIL: ${FAIL}"
if [ ${FAIL} -gt 0 ]; then
    echo "FAILED TESTS:${FAILED_TESTS}"
fi
echo "============================================"
echo "Done - $(date)"
