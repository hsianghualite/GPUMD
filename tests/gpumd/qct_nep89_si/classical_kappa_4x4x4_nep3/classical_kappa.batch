#!/bin/bash
#SBATCH --job-name=cl-k-nep3
#SBATCH --partition=16V100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --qos=flood-1o2gpu
#SBATCH --time=04:00:00

source /etc/profile.d/lmod.sh
module load cuda/12.4.1
export OMP_NUM_THREADS=1
source /opt/sai_config/mps_mapping.d/${SLURM_JOB_PARTITION}.bash

REVIEW_ROOT="$HOME/workdir_sinano-fanzhaochuan/yishangzhao/gpumd-qct-review"
GPUMD_BIN="${REVIEW_ROOT}/src/gpumd"
TEST_DIR="${REVIEW_ROOT}/tests/gpumd/qct_nep89_si/classical_kappa_4x4x4_nep3"

echo "============================================"
echo "Classical Thermal Conductivity (NEP3 3body) - $(date)"
echo "System: Si diamond 4x4x4 (512 atoms), Si_2022_NEP3_3body, 300K"
echo "Production: 500 ps, HAC: 40 ps correlation, 10 blocks"
echo "Binary: ${GPUMD_BIN}"
echo "Node:   $(hostname)"
echo "============================================"

cd "${TEST_DIR}" || { echo "FAIL: cannot cd to ${TEST_DIR}"; exit 1; }

rm -f gpumd.log thermo.out hac.out stress.out neighbor.out

echo "--- GPU info ---"
nvidia-smi -L 2>&1 | head -2
echo ""
echo "--- run.in ---"
cat run.in
echo ""
echo "--- model.xyz (header) ---"
head -2 model.xyz
echo ""
echo "--- NEP model file ---"
ls -la Si_2022_NEP3_3body.txt
head -1 Si_2022_NEP3_3body.txt

echo ""
echo "=== Running GPUMD ==="
"${GPUMD_BIN}" > gpumd.log 2>&1
rc=$?

if [ ${rc} -ne 0 ]; then
    echo "FAIL: gpumd exited with code ${rc}"
    echo "--- last 100 lines of gpumd.log ---"
    tail -100 gpumd.log 2>/dev/null
    exit 1
fi
echo "GPUMD exit code: ${rc}"

echo ""
echo "--- gpumd.log (key lines) ---"
grep -E "Use |NVT|NVE|Run |HAC|heat|periodic|PBC|atoms|step|temperature" gpumd.log 2>/dev/null | head -30

echo ""
echo "--- Output files ---"
ls -la

# Check thermo output
if [ -f "thermo.out" ]; then
    echo ""
    echo "--- thermo.out analysis ---"
    python3 -c "
import numpy as np
data = np.loadtxt('thermo.out')
print(f'Thermo data: {data.shape[0]} rows')
n_nvt = 200000 // 100  # 2000 rows for NVT phase
print(f'Phase 1 (NVT, first {n_nvt} rows):')
print(f'  T range: {data[:n_nvt,0].min():.1f} - {data[:n_nvt,0].max():.1f} K')
print(f'  T mean:  {data[:n_nvt,0].mean():.1f} K')
if data.shape[0] > n_nvt:
    nve = data[n_nvt:]
    print(f'Phase 2 (NVE, rows {n_nvt}+):')
    print(f'  T range: {nve[:,0].min():.1f} - {nve[:,0].max():.1f} K')
    print(f'  T mean:  {nve[:,0].mean():.1f} K')
    if data.shape[1] >= 4:
        e_drift = nve[-1,3] - nve[0,3]
        e_mean = np.mean(nve[:,3])
        print(f'  Energy drift: {e_drift:.6f} eV ({e_drift/e_mean*100:.4f}%)')
" 2>&1
fi

# Check HAC output
if [ -f "hac.out" ]; then
    echo ""
    echo "--- hac.out info ---"
    wc -l hac.out
    echo "--- hac.out (first 3 lines) ---"
    head -3 hac.out
    echo "..."
    echo "--- hac.out (last 3 lines) ---"
    tail -3 hac.out

    echo ""
    echo "=== Thermal Conductivity Analysis ==="
    python3 -c "
import numpy as np
data = np.loadtxt('hac.out')
ncols = data.shape[0]
t = data[:, 0]
print(f'HAC data: {ncols} rows, {data.shape[1]} columns')
print(f'Time range: {t[0]:.4f} - {t[-1]:.4f} ps')
print(f'Correlation window: {t[-1]:.1f} ps')

kx = data[:, 6] + data[:, 7]
ky = data[:, 8] + data[:, 9]
kz = data[:, 10]
kappa_avg = (kx + ky + kz) / 3.0

print(f'')
print(f'Final kappa values:')
print(f'  kappa_x = {kx[-1]:.4f} W/m/K')
print(f'  kappa_y = {ky[-1]:.4f} W/m/K')
print(f'  kappa_z = {kz[-1]:.4f} W/m/K')
print(f'  kappa_avg = {kappa_avg[-1]:.4f} W/m/K')

print(f'')
print(f'Convergence check (kappa_avg at different correlation times):')
for frac in [0.25, 0.5, 0.75, 1.0]:
    idx = int(ncols * frac) - 1
    if idx > 0:
        print(f'  {t[idx]:.1f} ps: {kappa_avg[idx]:.4f} W/m/K')

last_q = kappa_avg[int(ncols*0.75):]
print(f'')
print(f'  Last 25% mean: {np.mean(last_q):.4f} W/m/K')
print(f'  Last 25% std:  {np.std(last_q):.4f} W/m/K')
print(f'  Last 25% RSD:  {np.std(last_q)/np.mean(last_q)*100:.1f}%')

print(f'')
print(f'Per-component (last 25% mean):')
for name, arr in [('kx', kx), ('ky', ky), ('kz', kz)]:
    lq = arr[int(ncols*0.75):]
    print(f'  {name}: {np.mean(lq):.4f} +/- {np.std(lq):.4f} W/m/K')
" 2>&1
else
    echo "WARNING: hac.out not found"
    tail -30 gpumd.log
    exit 1
fi

echo ""
echo "============================================"
echo "Classical kappa test (NEP3 3body) completed - $(date)"
echo "============================================"
